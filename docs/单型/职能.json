{
  "版本": 1,
  "是": "职能",
  "说明": "职能是可自定义的 class（制作人 2026-09-05 01:38 定）：用户可新建/删除/修改行，也可改 字段 加属性。性质是类型系统、定死四种；职能是数据。单型 = 职能 × 性质。领域/单型 校验每张工单的 职能 必须在 表 里。",

  "字段": {
    "名":           { "类型": "string", "必填": true,  "说明": "职能名，工单 frontmatter 的 职能 字段引用它" },
    "接":           { "类型": "string", "必填": true,  "说明": "接什么单（人读的叫法，如「系统策划单」）" },
    "产出":         { "类型": "string", "必填": true,  "说明": "产出什么资产类型（如「系统策划案」「代码」「模型」）" },
    "产出属于":     { "类型": "enum",   "必填": true,  "合法值": ["方案", "资产", "成果"], "说明": "产出落在产出三型的哪一型；决定验收方式（资产机判、方案人判、成果跑起来）" },
    "默认可碰目录": { "类型": "list",   "必填": false, "默认": [], "说明": "协议未写时的兜底权限。协议里写了以协议为准，工单可再收紧不可放宽（Q6）" },
    "协议档":       { "类型": "path",   "必填": false, "默认": null, "说明": "这一职能的默认协议文件（协议/<名>.md）。为空则用职能范本" },
    "启用":         { "类型": "bool",   "必填": false, "默认": true,  "说明": "false = 名单里有、不接单。留给「先列着、需要时再开」的职能" }
  },

  "表": [
    { "名": "系统策划", "接": "系统策划单", "产出": "系统策划案", "产出属于": "资产" },
    { "名": "关卡策划", "接": "关卡/场景单", "产出": "关卡设计",   "产出属于": "资产", "备注": "产出是设计不是场景文件；场景文件归 关卡·装配（待制作人确认）" },
    { "名": "数值策划", "接": "数值配置单", "产出": "配置表",     "产出属于": "资产" },
    { "名": "战斗策划", "接": "战斗需求单", "产出": "战斗机制",   "产出属于": "资产" },
    { "名": "技术策划", "接": "技术方案单", "产出": "技术方案",   "产出属于": "方案" },
    { "名": "程序",     "接": "代码单",     "产出": "代码",       "产出属于": "资产" },
    { "名": "原画美术", "接": "原画需求单", "产出": "原画",       "产出属于": "资产" },
    { "名": "建模美术", "接": "建模单",     "产出": "模型",       "产出属于": "资产" },
    { "名": "动画",     "接": "动画单",     "产出": "动画",       "产出属于": "资产" },
    { "名": "UI",       "接": "UI 单",      "产出": "UI",         "产出属于": "资产" },

    { "名": "音频",     "接": "音频需求单", "产出": "音频资源",   "产出属于": "资产", "启用": false, "备注": "旧仓零张，游戏必有。待制作人决定启用" },
    { "名": "特效",     "接": "特效需求单", "产出": "粒子/Shader 效果", "产出属于": "资产", "启用": false, "备注": "同上" },
    { "名": "技术美术", "接": "美术管线/性能单", "产出": "材质/管线/优化", "产出属于": "资产", "启用": false, "备注": "同上" },
    { "名": "叙事",     "接": "文本需求单", "产出": "世界观/对白/任务文本表", "产出属于": "资产", "启用": false, "备注": "同上" }
  ],

  "待制作人定": [
    "关卡策划的产出是设计还是场景文件（表里按「设计」写，场景文件走 关卡·装配）",
    "构建/打包/工具脚本归程序，还是单独一个职能",
    "后四行（音频/特效/技术美术/叙事）要不要启用"
  ]
}
